# 改写节点 LLM（Moonshot / Kimi）
# 从 https://platform.moonshot.cn/ 获取
KIMI_API_KEY=your-kimi-api-key

# 原生路线（Google Gemini 原生图像生成）
# 从 https://aistudio.google.com/apikey 获取
GEMINI_API_KEY=your-gemini-api-key

# 工作流路线生图工具（阿里云百炼 DashScope 国际站，通义万相文生图）
# 从 https://www.alibabacloud.com/help/en/model-studio/get-api-key 获取
DASHSCOPE_API_KEY=your-dashscope-api-key

# 工作流路线生图工具（首选方案，实验时账户余额为 0 不可用，保留作记录）
SILICONFLOW_API_KEY=your-siliconflow-api-key

# GPT-Image 2 原生路线（native_gptimage）所需，为必选 key 之一
# （Config.required_env 要求 KIMI / DASHSCOPE / GEMINI / OPENAI 四个都设）
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=your-openai-api-key

# 可选配置（均有默认值）
# REWRITE_MODEL=kimi-k3
# WANX_MODEL=wan2.2-t2i-flash
# WANX_SIZE=1024*1024
# GEMINI_IMAGE_MODEL=gemini-3-pro-image
# GPT_IMAGE_MODEL=gpt-image-2
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
# SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
