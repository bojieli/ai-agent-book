# Kimi API 配置
# 从 https://platform.moonshot.cn/ 获取您的 API Key
MOONSHOT_API_KEY=your-api-key-here

# 可选配置
# 注意：下面三条目前仅作代码常量，代码不会读取环境变量，仅 SEARCH_TIMEOUT 真正生效
# KIMI_BASE_URL=https://api.moonshot.cn/v1      # 当前未被代码读取（config 硬编码）
# DEFAULT_MODEL=kimi-k3                          # 当前未被代码读取（config 硬编码）
# MAX_SEARCH_ITERATIONS=5                        # 当前未被代码读取（config 硬编码）
# SEARCH_TIMEOUT=180                             # 唯一真正被读取的可选配置

# 通用兜底：当 MOONSHOT_API_KEY 缺失时，若设置了 OPENROUTER_API_KEY，
# 请求会自动改走 OpenRouter。请求的模型 id 会被映射为 OpenRouter 等价 id
# （默认 kimi-k3 映射为 moonshotai/kimi-k2.6）；仅当未指定模型时才使用
# OPENROUTER_MODEL（默认 openai/gpt-5.6-luna）。注意：Kimi 内置 $web_search
# 工具在 OpenRouter 上不可用，此兜底模式下模型仅凭自身知识作答（无实时联网搜索）。
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=openai/gpt-5.6-luna