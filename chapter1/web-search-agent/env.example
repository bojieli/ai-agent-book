# 联网模式需要一个模型 API Key。从下方选择直连 Kimi 或 OpenRouter。
# 从 https://platform.moonshot.cn/ 获取您的 API Key
# MOONSHOT_API_KEY=your-api-key-here

# 可选配置
# KIMI_BASE_URL=https://api.moonshot.cn/v1      # 代理 / 区域端点；留空则使用官方端点
# SEARCH_TIMEOUT=180                             # 单次请求超时（秒）
# 注意：下面两条目前仅作代码常量，config.py 不会读取这两个环境变量
# DEFAULT_MODEL=kimi-k3                          # 当前未被代码读取（config 硬编码）
# MAX_SEARCH_ITERATIONS=5                        # 当前未被代码读取（config 硬编码）

# 使用 OpenRouter 时，请留空 MOONSHOT_API_KEY 和 KIMI_API_KEY。
# 默认模型会映射为 moonshotai/kimi-k2.6。省略 --provider 时，搜索走 Parallel MCP。
# 调用搜索工具时，模型生成的搜索词会匿名发给 Parallel，无需额外密钥。
# 在 OpenRouter 上指定 --provider kimi 只调用模型，offline-demo 则只回放本地示例。
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=openai/gpt-5.6-luna  # 解析器需要备用模型时使用
