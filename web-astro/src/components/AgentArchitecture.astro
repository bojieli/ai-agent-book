---
import { editions, translator, type Locale } from '../lib/i18n';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const t = translator(locale);
const stages = [
  {
    label: t('Reason'),
    detail: t('The model uses that context to choose its next action.'),
  },
  {
    label: t('Act'),
    detail: t(
      'Tools act on the environment; the results become new observations.',
    ),
  },
  {
    label: t('Observe'),
    detail: t('Observations update the context available to the model.'),
  },
];
---

<section
  class="agent-motion"
  data-stage="0"
  aria-labelledby="architecture-title"
>
  <div class="motion-heading">
    <span class="motion-kicker">{t('THE AGENT LOOP')}</span><span
      class="edition-number">{t('CONCEPTUAL MODEL')}</span
    >
  </div>
  <div
    class="agent-scene"
    dir="ltr"
    role="img"
    aria-label={t(
      'Context supplies observations to the LLM. The model chooses tools, which act on the environment. Feedback from the environment returns to context.',
    )}
  >
    <svg class="circuit" viewBox="0 0 640 460" fill="none" aria-hidden="true">
      <g class="circuit-paths">
        <path data-route="observe" d="M174 382H116Q80 382 80 346V252"></path>
        <path data-route="reason" d="M147 180H241"></path>
        <path data-route="select" d="M399 180H493"></path>
        <path data-route="execute" d="M560 252V346Q560 382 524 382H466"></path>
      </g>
      <g class="energy-paths" aria-hidden="true">
        <path data-energy="0" pathLength="1" d="M174 382H116Q80 382 80 346V252"
        ></path>
        <path data-energy="1" pathLength="1" d="M147 180H241"></path>
        <path data-energy="2" pathLength="1" d="M399 180H493"></path>
        <path
          data-energy="3"
          pathLength="1"
          d="M560 252V346Q560 382 524 382H466"></path>
      </g>
      <g class="packet-stream" opacity="0" aria-hidden="true">
        {
          [0, 1, 2, 3, 4, 5].map((index) => (
            <circle
              data-packet={index}
              r={index === 0 ? 5 : 3.5 - index * 0.35}
            />
          ))
        }
      </g>
      <g class="flow-arrowheads" aria-hidden="true">
        <path data-arrowhead="0" d="m76 258 4-6 4 6"></path>
        <path data-arrowhead="1" d="m235 176 6 4-6 4"></path>
        <path data-arrowhead="2" d="m487 176 6 4-6 4"></path>
        <path data-arrowhead="3" d="m472 378-6 4 6 4"></path>
      </g>
      <g class="processing-waves" aria-hidden="true">
        <circle data-wave="0" cx="320" cy="180" r="88"></circle>
        <circle data-wave="1" cx="320" cy="180" r="88"></circle>
      </g>
    </svg>
    <div class="model-core">
      <div class="core-inner"><strong>LLM</strong></div>
    </div>
    <span class="model-label" dir={editions[locale].dir}
      >{t('Reasoning engine')}</span
    >
    <div class="context-node side-node">
      <svg
        class="context-visual node-visual"
        viewBox="0 0 90 44"
        fill="none"
        aria-hidden="true"
      >
        <rect class="context-sheet" x="20" y="3" width="54" height="29" rx="4"
        ></rect>
        <rect class="context-sheet" x="14" y="8" width="54" height="29" rx="4"
        ></rect>
        <rect
          class="context-sheet front-sheet"
          x="8"
          y="13"
          width="54"
          height="29"
          rx="4"></rect>
        <path d="M18 23h33M18 29h25M18 35h17"></path>
        <circle class="incoming-observation" cx="72" cy="29" r="7"
        ></circle><path class="incoming-mark" d="M69 29h6m-3-3v6"></path>
      </svg><strong>{t('Context')}</strong><span
        class="node-description"
        dir={editions[locale].dir}
        >{t('Task · history')}<br />{t('observations')}</span
      >
    </div>
    <div class="tools-node side-node">
      <svg
        class="tools-visual node-visual"
        viewBox="0 0 96 44"
        fill="none"
        aria-hidden="true"
      >
        <g class="search-tool"
          ><rect x="2" y="8" width="28" height="28" rx="6"></rect><circle
            cx="14"
            cy="20"
            r="5"></circle><path d="m18 24 5 5"></path></g
        >
        <g class="code-tool"
          ><rect x="34" y="8" width="28" height="28" rx="6"></rect><path
            d="m43 17-5 5 5 5m10-10 5 5-5 5m-4-11-3 14"></path></g
        >
        <g class="api-tool"
          ><rect x="66" y="8" width="28" height="28" rx="6"></rect><path
            d="M75 16v6h10v6m-10-6v6"></path><circle cx="75" cy="14" r="2"
          ></circle><circle cx="75" cy="30" r="2"></circle><circle
            cx="85"
            cy="30"
            r="2"></circle></g
        >
      </svg><strong>{t('Tools')}</strong><span
        class="node-description"
        dir={editions[locale].dir}>{t('Search · code')}<br />APIs</span
      >
    </div>
    <span class="flow-label observations-label">{t('Observations')}</span><span
      class="flow-label actions-label">{t('Actions')}</span
    >
    <div class="environment-label" dir={editions[locale].dir}>
      <svg
        class="world-visual"
        viewBox="0 0 110 30"
        fill="none"
        aria-hidden="true"
      >
        <path d="M8 4h11l6 6v16H8Zm10 0v7h7M12 16h9m-9 5h7"></path>
        <rect x="40" y="5" width="28" height="21" rx="3"></rect><path
          d="M40 11h28"></path><circle cx="45" cy="8" r=".7"></circle><circle
          cx="49"
          cy="8"
          r=".7"></circle>
        <circle cx="94" cy="10" r="5"></circle><path
          d="M85 27v-3a9 9 0 0 1 18 0v3"></path>
      </svg><strong>{t('Environment')}</strong><span
        >{t('Files · browsers · people')}</span
      >
    </div>
  </div>
  <div class="loop-caption">
    <h2 id="architecture-title">
      {t('Decide. Act.')}<br /><em>{t('Observe what changed.')}</em>
    </h2>
  </div>
  <div class="motion-controls" hidden>
    <div class="stage-buttons" aria-label={t('Explore the agent loop')}>
      {
        stages.map((stage, index) => (
          <button
            type="button"
            data-select-stage={index}
            data-description={stage.detail}
            aria-pressed={index === 0}
            aria-controls="agent-explanation"
          >
            <span class="step-dot" aria-hidden="true" />
            {stage.label}
          </button>
        ))
      }
    </div>
    <button class="motion-play" type="button" aria-label={t('Pause animation')}
      ><svg
        viewBox="0 0 20 20"
        width="16"
        height="16"
        fill="currentColor"
        aria-hidden="true"
        ><path class="pause-symbol" d="M5 4h3v12H5zm7 0h3v12h-3z"></path><path
          class="play-symbol"
          d="m6 3 11 7-11 7z"></path></svg
      ><span class="playback-label">{t('Pause')}</span></button
    >
  </div>
  <p id="agent-explanation" class="motion-explanation">
    {t('Context informs the model. Tools act on the world.')}
  </p>
</section>
<script>
  import { browserTranslator } from '../lib/i18n';
  const t = browserTranslator();
  const panel = document.querySelector<HTMLElement>('.agent-motion');
  if (panel) {
    const routes = ['observe', 'reason', 'select', 'execute'].map((name) =>
      panel.querySelector<SVGPathElement>(`[data-route="${name}"]`)!,
    );
    let lengths = routes.map((path) => path.getTotalLength());
    const scene = panel.querySelector<HTMLElement>('.agent-scene')!;
    const circuit = panel.querySelector<SVGSVGElement>('.circuit')!;
    const core = panel.querySelector<HTMLElement>('.model-core')!;
    const context = panel.querySelector<HTMLElement>('.context-node')!;
    const tools = panel.querySelector<HTMLElement>('.tools-node')!;
    const environment = panel.querySelector<HTMLElement>('.environment-label')!;
    let coreRadius = 80;
    const packetStream = panel.querySelector<SVGGElement>('.packet-stream')!;
    const packets = [
      ...panel.querySelectorAll<SVGCircleElement>('[data-packet]'),
    ];
    const energyPaths = [
      ...panel.querySelectorAll<SVGPathElement>('[data-energy]'),
    ];
    const arrowheads = [
      ...panel.querySelectorAll<SVGPathElement>('[data-arrowhead]'),
    ];
    const waves = [...panel.querySelectorAll<SVGCircleElement>('[data-wave]')];
    const buttons = [
      ...panel.querySelectorAll<HTMLButtonElement>('[data-select-stage]'),
    ];
    const descriptions = buttons.map(
      (button) => button.dataset.description ?? '',
    );
    const playback = panel.querySelector<HTMLButtonElement>('.motion-play')!;
    const explanation = panel.querySelector<HTMLElement>(
      '.motion-explanation',
    )!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = reducedMotion.matches;
    let animate = !reducedMotion.matches;
    const initialBounds = panel.getBoundingClientRect();
    let visible = initialBounds.bottom > 0 && initialBounds.top < innerHeight;
    let stage = 0;
    const duration = 3600;
    let elapsed = paused ? duration : 0;
    let previous = 0;
    let frame = 0;
    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    const ease = (value: number) => {
      const t = clamp(value);
      return t * t * (3 - 2 * t);
    };
    const draw = () => {
      const progress = elapsed / duration;
      const motion = animate;
      let routeIndex = 1;
      let travel = 0;
      let travelling = true;
      let contextEnergy = 0;
      let modelEnergy = 0;
      let toolEnergy = 0;
      let resultEnergy = 0;
      const reveal = [0, 0, 0, 0];
      if (stage === 0) {
        travel = ease(progress / 0.3);
        travelling = progress <= 0.3;
        reveal[1] = travel;
        // A pair of expanding waves signals the model processing the received context.
        modelEnergy =
          progress > 0.24
            ? Math.sin(clamp((progress - 0.24) / 0.76) * Math.PI)
            : 0;
      } else if (stage === 1) {
        routeIndex = progress < 0.4 ? 2 : 3;
        travel =
          routeIndex === 2
            ? ease(progress / 0.25)
            : ease((progress - 0.4) / 0.48);
        travelling = progress < 0.25 || (progress >= 0.4 && progress <= 0.88);
        reveal[2] = ease(progress / 0.25);
        reveal[3] = ease((progress - 0.4) / 0.48);
        toolEnergy = Math.sin(clamp((progress - 0.2) / 0.25) * Math.PI);
        resultEnergy = Math.sin(clamp((progress - 0.82) / 0.18) * Math.PI);
      } else {
        routeIndex = 0;
        travel = ease((progress - 0.06) / 0.66);
        travelling = progress >= 0.06 && progress <= 0.72;
        reveal[0] = travel;
        contextEnergy = Math.sin(clamp((progress - 0.65) / 0.35) * Math.PI);
      }
      energyPaths.forEach((path, index) => {
        path.style.strokeDashoffset = String(1 - reveal[index]);
        path.style.opacity = reveal[index] ? '1' : '0';
      });
      packetStream.setAttribute('opacity', motion && travelling ? '1' : '0');
      packets.forEach((packet, index) => {
        const distance = lengths[routeIndex] * travel - index * 9;
        const point = routes[routeIndex].getPointAtLength(
          Math.max(0, distance),
        );
        packet.setAttribute('cx', String(point.x));
        packet.setAttribute('cy', String(point.y));
        packet.setAttribute(
          'opacity',
          distance < 0 ? '0' : String(1 - index * 0.15),
        );
      });
      waves.forEach((wave, index) => {
        const t = clamp((progress - 0.28 - index * 0.2) / 0.48);
        wave.setAttribute('r', String(coreRadius + 4 + ease(t) * 24));
        wave.style.opacity =
          motion && stage === 0 ? String(Math.sin(t * Math.PI) * 0.65) : '0';
      });
      panel.style.setProperty(
        '--context-energy',
        String(motion ? contextEnergy : 0),
      );
      panel.style.setProperty(
        '--model-energy',
        String(motion ? modelEnergy : 0),
      );
      panel.style.setProperty('--tool-energy', String(motion ? toolEnergy : 0));
      panel.style.setProperty(
        '--result-energy',
        String(motion ? resultEnergy : 0),
      );
    };
    // HTML labels wrap independently of the SVG. Connect their actual bounds,
    // and give the animated stroke exactly the same route as the visible arrow.
    const layoutRoutes = () => {
      const bounds = scene.getBoundingClientRect();
      if (!bounds.width || !bounds.height) return;
      const box = (element: HTMLElement) => {
        const rect = element.getBoundingClientRect();
        return {
          left: rect.left - bounds.left,
          right: rect.right - bounds.left,
          top: rect.top - bounds.top,
          bottom: rect.bottom - bounds.top,
          x: rect.left - bounds.left + rect.width / 2,
          y: rect.top - bounds.top + rect.height / 2,
        };
      };
      const c = box(context);
      const tool = box(tools);
      const world = box(environment);
      // Ignore the model's animated scale when finding its resting boundary.
      coreRadius = core.offsetWidth / 2;
      const modelX = core.offsetLeft;
      const modelY = core.offsetTop;
      const gap = 10;
      const bend = Math.min(22, (world.left - c.x) / 2);
      const paths = [
        `M${world.left - gap} ${world.y}H${c.x + bend}Q${c.x} ${world.y} ${c.x} ${world.y - bend}V${c.bottom + gap}`,
        `M${c.right + gap} ${modelY}H${modelX - coreRadius - gap}`,
        `M${modelX + coreRadius + gap} ${modelY}H${tool.left - gap}`,
        `M${tool.x} ${tool.bottom + gap}V${world.y - bend}Q${tool.x} ${world.y} ${tool.x - bend} ${world.y}H${world.right + gap}`,
      ];
      circuit.setAttribute('viewBox', `0 0 ${bounds.width} ${bounds.height}`);
      paths.forEach((path, index) => {
        routes[index].setAttribute('d', path);
        energyPaths[index].setAttribute('d', path);
      });
      lengths = routes.map((path) => path.getTotalLength());
      const tips = [
        `M${c.x - 3} ${c.bottom + gap + 5}l3-5 3 5`,
        `M${modelX - coreRadius - gap - 5} ${modelY - 3}l5 3-5 3`,
        `M${tool.left - gap - 5} ${modelY - 3}l5 3-5 3`,
        `M${world.right + gap + 5} ${world.y - 3}l-5 3 5 3`,
      ];
      tips.forEach((path, index) => arrowheads[index].setAttribute('d', path));
      waves.forEach((wave) => {
        wave.setAttribute('cx', String(modelX));
        wave.setAttribute('cy', String(modelY));
      });
      for (const [selector, node] of [
        ['.observations-label', c],
        ['.actions-label', tool],
      ] as const) {
        const label = panel.querySelector<HTMLElement>(selector)!;
        label.style.top = `${Math.max(node.bottom + 12, (node.bottom + world.top - label.offsetHeight) / 2)}px`;
      }
      draw();
    };
    const setStage = (next: number) => {
      stage = next;
      panel.dataset.stage = String(stage);
      routes.forEach((route, index) => {
        const active =
          stage === 0 ? index === 1 : stage === 1 ? index >= 2 : index === 0;
        route.dataset.active = String(active);
        arrowheads[index].dataset.active = String(active);
      });
      buttons.forEach((button, index) =>
        button.setAttribute('aria-pressed', String(index === stage)),
      );
      explanation.textContent = descriptions[stage];
    };
    const tick = (now: number) => {
      frame = 0;
      if (paused || !visible || document.hidden) {
        previous = 0;
        return;
      }
      if (previous) elapsed += Math.min(now - previous, 100);
      previous = now;
      if (elapsed >= duration) {
        elapsed %= duration;
        setStage((stage + 1) % 3);
      }
      draw();
      frame = requestAnimationFrame(tick);
    };
    const syncPlayback = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      previous = 0;
      panel.dataset.paused = String(paused);
      panel.dataset.motion = animate ? 'full' : 'reduced';
      draw();
      playback.querySelector('.playback-label')!.textContent = paused
        ? t('Play')
        : t('Pause');
      playback.setAttribute(
        'aria-label',
        paused ? t('Play animation') : t('Pause animation'),
      );
      if (!paused && visible && !document.hidden)
        frame = requestAnimationFrame(tick);
    };
    buttons.forEach((button, index) =>
      button.addEventListener('click', () => {
        // Selecting a stage keeps the current playback preference.
        elapsed = paused ? duration : 0;
        setStage(index);
        draw();
        syncPlayback();
      }),
    );
    playback.addEventListener('click', () => {
      paused = !paused;
      // Explicit Play opts into motion; the initial state respects the OS setting.
      if (!paused) {
        animate = true;
        if (elapsed >= duration) elapsed = 0;
      }
      syncPlayback();
    });
    reducedMotion.addEventListener('change', () => {
      animate = !reducedMotion.matches;
      if (reducedMotion.matches) paused = true;
      draw();
      syncPlayback();
    });
    document.addEventListener('visibilitychange', syncPlayback);
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        syncPlayback();
      },
      { threshold: 0.01 },
    ).observe(panel.querySelector('.agent-scene')!);
    panel.querySelector<HTMLElement>('.motion-controls')!.hidden = false;
    setStage(0);
    const layoutObserver = new ResizeObserver(layoutRoutes);
    [scene, context, tools, environment, core].forEach((node) =>
      layoutObserver.observe(node),
    );
    layoutRoutes();
    syncPlayback();
  }
</script>
<style>
  .agent-motion {
    --signal: #768c3d;
    --route: #adb99d;
    align-self: center;
    position: relative;
    min-width: 0;
    padding: 0 0 12px;
    color: var(--ink);
  }
  .motion-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 14px;
    padding-bottom: 17px;
    border-bottom: 1px solid var(--line);
  }
  .motion-kicker,
  .edition-number {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .edition-number {
    font-variant-numeric: tabular-nums;
  }
  .agent-scene {
    position: relative;
    width: 100%;
    aspect-ratio: 640/460;
    min-height: 330px;
    margin: 18px 0 0;
  }
  .circuit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .circuit-paths {
    stroke: var(--route);
    transition: stroke 0.35s;
    stroke-width: 1.8;
    color: #899673;
  }

  .model-core {
    position: absolute;
    left: 50%;
    top: 39.13%;
    transform: translate(-50%, -50%);
    width: 25%;
    aspect-ratio: 1;
    container-type: inline-size;
    border-radius: 50%;
    padding: 5px;
    background: linear-gradient(145deg, #e4e9db, #c1cdac 48%, #fcfff6);
    box-shadow:
      0 16px 34px -14px #354b4155,
      0 0 0 8px #d7e0c820;
    z-index: 2;
    transition: box-shadow 0.8s;
  }
  .core-inner {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 35% 5%,
      #50614a 0%,
      #293729 48%,
      #162019 100%
    );
    color: #f2f8e8;
    box-shadow:
      inset 0 1px 2px #ffffff66,
      inset 0 -6px 16px #0003;
  }

  .core-inner strong {
    font: 450 clamp(1.4rem, 38cqi, 3rem)/1 var(--serif);
    letter-spacing: -0.03em;
    margin: 0;
  }

  .side-node {
    position: absolute;
    top: 39.13%;
    transform: translate(-50%, -50%);
    width: 23%;
    background: var(--bg);
    padding: 8px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 1;
  }
  .context-node {
    left: 12.5%;
  }
  .tools-node {
    left: 87.5%;
  }

  .side-node strong {
    font-size: clamp(0.9rem, 1.5vw, 1.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .node-description {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 5px;
    line-height: 1.4;
    white-space: nowrap;
  }

  .flow-label {
    position: absolute;
    top: 67%;
    font-size: 0.75rem;
    color: var(--muted);
    width: 27%;
    padding: 0;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .observations-label {
    left: calc(12.5% + 12px);
  }
  .actions-label {
    right: calc(12.5% + 12px);
    text-align: right;
  }
  .environment-label {
    position: absolute;
    left: 50%;
    top: 79.5%;
    transform: translateX(-50%);
    background: var(--bg);
    padding: 0 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    white-space: nowrap;
  }

  .environment-label strong {
    font-size: 0.875rem;
    font-weight: 500;
    margin-top: 4px;
  }
  .environment-label > span:last-child {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 5px;
  }

  [data-stage='0'] .model-core {
    box-shadow:
      0 16px 35px -10px #48633466,
      0 0 0 10px #d8ed7a25,
      0 0 50px -15px #acc56f88;
  }

  .loop-caption {
    text-align: center;
    margin-top: 24px;
  }
  .loop-caption h2 {
    font-family: var(--serif);
    font-size: 1.55rem;
    line-height: 1.25;
    letter-spacing: -0.035em;
    font-weight: 450;
    margin: 0;
  }
  .loop-caption h2 em {
    font-style: italic;
    color: var(--muted);
  }
  .motion-controls {
    display: flex;
    gap: 13px;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
  }
  .stage-buttons {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 30px;
    padding: 3px;
    gap: 2px;
    background: var(--bg);
  }
  .stage-buttons button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-radius: 24px;
    font-size: 0.75rem;
    font-weight: 550;
    color: var(--muted);
    min-height: 40px;
    padding: 8px 13px;
    transition:
      background 0.4s,
      color 0.4s;
  }
  .stage-buttons button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .stage-buttons button:hover:not([aria-pressed='true']) {
    background: var(--surface);
  }
  .step-dot {
    height: 4px;
    width: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }
  .stage-buttons button[aria-pressed='true'] .step-dot {
    background: var(--accent);
    opacity: 1;
  }
  .motion-play {
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    height: 42px;
