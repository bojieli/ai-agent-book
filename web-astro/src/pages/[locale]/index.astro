---
import Home from '../../components/Home.astro';
import { locales } from '../../lib/i18n';
export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== 'zh-CN')
    .map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
---

<Home locale={locale} />
